<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvClosureDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Closure Date: "
        android:textColor="#1F2937"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reason for Closure"
        android:textColor="#374151"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etClosureReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_rounded"
        android:hint="e.g., Public Holiday, Maintenance, etc."
        android:textColorHint="#9CA3AF"
        android:textColor="#1F2937"
        android:textSize="14sp"
        android:padding="14dp"
        android:inputType="text"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ All users will be notified about this closure.\nDue dates will be auto-extended if today is the closure date."
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>
